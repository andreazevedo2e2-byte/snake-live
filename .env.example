#
# Snake Live - environment variables
# ----------------------------------
# Supabase is NOT required by the current app architecture.
# The game currently runs with a local/frontend app plus a Node WebSocket chat server.
#

# Frontend
# In production, point this to a reachable WebSocket backend.
VITE_CHAT_WS_URL=ws://localhost:8787

# Backend
PORT=8787

# Chat source:
# - fake    -> rehearsal mode with simulated chat events
# - silent  -> starts the server without emitting chat events
# - youtube -> reads a live YouTube chat from SNAKE_LIVE_URL
SNAKE_CHAT=fake

# Required only when SNAKE_CHAT=youtube
SNAKE_LIVE_URL=https://www.youtube.com/watch?v=YOUR_VIDEO_ID
